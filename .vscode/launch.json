{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kezak — dev (serveur)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Kezak — production locale",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/server/entry.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
