---
import Admin from '../../layouts/Admin.astro';
import ListeOrdonnee from '../../components/admin/ListeOrdonnee.astro';
import { etapesContact, tousReglages } from '../../lib/db';

const csrf = Astro.locals.csrf;
const retour = '/admin/contact';
const r = tousReglages();
---

<Admin titre="Contact" sousTitre="L'en-tête, la colonne de droite et les étapes." voir="/contact">
  <section class="adm__section">
    <header><h2 class="adm__num">00 — En-tête</h2></header>
    <form method="post" action="/admin/api/enregistrer">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="retour" value={retour} />
      <p class="adm__champ">
        <label for="contact_intro">Texte d'introduction</label>
        <textarea id="contact_intro" name="r_contact_intro" rows="3" set:text={r.contact_intro} />
      </p>
      <p class="adm__champ">
        <label for="contact_description">Description pour les moteurs de recherche</label>
        <input type="text" id="contact_description" name="r_contact_description" value={r.contact_description} />
      </p>
      <div class="adm__actions">
        <button class="adm__bouton adm__bouton--plein" type="submit">Enregistrer</button>
      </div>
    </form>
  </section>

  <section class="adm__section">
    <header><h2 class="adm__num">01 — Colonne « Directement »</h2></header>
    <p class="adm__aide">
      Le téléphone est facultatif : un numéro publié attire aussi du démarchage. Laissez le champ
      vide pour qu'il ne s'affiche pas.
    </p>
    <form method="post" action="/admin/api/enregistrer">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="retour" value={retour} />
      <div class="adm__duo">
        <p class="adm__champ">
          <label for="email">Adresse e-mail</label>
          <input type="email" id="email" name="r_email" value={r.email} />
        </p>
        <p class="adm__champ">
          <label for="telephone">Téléphone</label>
          <input type="text" id="telephone" name="r_telephone" value={r.telephone} />
        </p>
      </div>
      <p class="adm__champ">
        <label for="contact_lieu">Lieu et zone d'intervention — colonne de droite de la page Contact</label>
        <input type="text" id="contact_lieu" name="r_contact_lieu" value={r.contact_lieu} />
      </p>
      <p class="adm__champ">
        <label for="contact_agences">Mention pour les agences</label>
        <textarea id="contact_agences" name="r_contact_agences" rows="3" set:text={r.contact_agences} />
      </p>
      <div class="adm__actions">
        <button class="adm__bouton adm__bouton--plein" type="submit">Enregistrer</button>
      </div>
    </form>
  </section>

  <section class="adm__section">
    <header><h2 class="adm__num">02 — Ce qui se passe ensuite</h2></header>
    <p class="adm__aide">
      Trois étapes suffisent. La première doit dire que vous répondez même pour refuser : c'est
      ce qui retire la crainte du silence.
    </p>
    <ListeOrdonnee
      table="etapes_contact"
      lignes={etapesContact()}
      retour={retour}
      libelleAjout="Ajouter une étape"
      champs={[{ nom: 'texte', libelle: 'Texte de l’étape', type: 'zone', lignes: 2 }]}
    />
  </section>
</Admin>
