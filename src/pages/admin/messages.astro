---
import Admin from '../../layouts/Admin.astro';
import { db } from '../../lib/db';

const csrf = Astro.locals.csrf;
const retour = '/admin/messages';
const messages = db.prepare('SELECT * FROM messages ORDER BY id DESC LIMIT 200').all() as any[];
const dateFr = (s: string) =>
  s ? `${s.slice(8, 10)}.${s.slice(5, 7)}.${s.slice(0, 4)} à ${s.slice(11, 16)}` : '';
---

<Admin titre="Messages" sousTitre="Ce que le formulaire de contact a reçu.">
  {
    messages.length === 0 ? (
      <div class="adm__vide">
        <p>
          Aucun message pour l'instant. Tout ce qui passe par le formulaire de contact arrive ici,
          et y reste même si l'envoi du courriel échoue.
        </p>
        <a class="adm__bouton adm__bouton--discret" href="/contact" target="_blank" rel="noopener">
          Voir le formulaire ↗
        </a>
      </div>
    ) : (
      messages.map((m) => (
        <article class="adm__section" id={`m${m.id}`}>
          <header>
            <span class="adm__num">
              {dateFr(m.cree_le)}
              {!m.lu && ' · non lu'}
            </span>
            <form method="post" action="/admin/api/message">
              <input type="hidden" name="csrf" value={csrf} />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="retour" value={retour} />
              <span class="adm__outils">
                <button class="adm__bouton adm__bouton--discret" name="action" value={m.lu ? 'non-lu' : 'lu'}>
                  {m.lu ? 'Marquer non lu' : 'Marquer lu'}
                </button>
                <button
                  class="adm__bouton adm__bouton--danger"
                  name="action"
                  value="supprimer"
                  data-confirmer="Supprimer ce message ? C'est définitif."
                >
                  Supprimer
                </button>
              </span>
            </form>
          </header>

          <h2 class="msg__qui">
            {m.nom}
            {m.orga && <span class="msg__orga"> — {m.orga}</span>}
          </h2>

          <dl class="msg__meta">
            <div>
              <dt>E-mail</dt>
              <dd>
                <a href={`mailto:${m.email}?subject=${encodeURIComponent('Votre message à Kezak')}`}>
                  {m.email}
                </a>
              </dd>
            </div>
            {m.tel && (
              <div>
                <dt>Téléphone</dt>
                <dd>{m.tel}</dd>
              </div>
            )}
            {m.besoins && (
              <div>
                <dt>Besoins</dt>
                <dd>{m.besoins}</dd>
              </div>
            )}
            {m.echeance && (
              <div>
                <dt>Échéance</dt>
                <dd>{m.echeance}</dd>
              </div>
            )}
            {m.budget && (
              <div>
                <dt>Budget</dt>
                <dd>{m.budget}</dd>
              </div>
            )}
          </dl>

          <p class="msg__corps">{m.corps}</p>
        </article>
      ))
    )
  }
</Admin>

<style>
  .msg__qui {
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.5rem;
    margin: 0 0 var(--e-3);
  }
  .msg__orga {
    color: var(--texte-papier-doux);
  }
  .msg__meta {
    margin: 0 0 var(--e-4);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--e-3);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }
  .msg__meta dt {
    color: var(--texte-papier-doux);
    text-transform: uppercase;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
  }
  .msg__meta dd {
    margin: 0.3rem 0 0;
  }
  .msg__corps {
    white-space: pre-wrap;
    max-width: 44rem;
    padding-top: var(--e-3);
    border-top: 1px solid var(--filet-papier);
  }
</style>
