  }
  .pdf-actuel__nom {
    flex: 1;
    min-width: 12rem;
    overflow-wrap: anywhere;
  }

  .apercu {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6rem, 1fr));
