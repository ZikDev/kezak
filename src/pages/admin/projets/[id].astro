  .ajouts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--e-4);
    margin-bottom: var(--e-5);
  }
  .ajout {
    border: 1px solid var(--filet-papier);
    background: #fff;
