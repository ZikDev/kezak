---
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import Grain from '../../components/Grain.astro';
import FacadeYoutube from '../../components/FacadeYoutube.astro';
import Carrousel from '../../components/Carrousel.astro';
import {
  projetParSlug,
  sectionsDuProjet,
  faitsDuProjet,
  creditsDuProjet,
  liensDuProjet,
  mediasDuProjet,
  projetSuivant,
  media,
  tousReglages,
} from '../../lib/db';
import { lienSur } from '../../lib/admin';
import { NOTE_CREDITS } from '../../lib/textes.mjs';

const { slug } = Astro.params;
const projet = projetParSlug(String(slug));

// Un brouillon reste visible pour un administrateur connecté, invisible
// pour tout le monde d'autre. La page 404 du site s'affiche, pas une
// réponse vide.
if (!projet || (projet.statut !== 'publie' && !Astro.locals.utilisateur)) {
  return Astro.rewrite('/404');
}

const r = tousReglages();
const sections = sectionsDuProjet(projet.id);
const faits = faitsDuProjet(projet.id);
const credits = creditsDuProjet(projet.id);
const galerie = mediasDuProjet(projet.id);
const suivant = projetSuivant(projet);
const hero = media(projet.hero_id);

/**
 * Les adresses sont repassées au filtre AU MOMENT DE L'AFFICHAGE, et pas
 * seulement à l'enregistrement.
 *
 * Ce n'est pas de la défiance envers l'administration : c'est que le
 * filtre d'écriture a été ajouté après coup, et qu'une base peut contenir
 * des lignes plus anciennes que lui. Une vérification à l'écriture protège
 * ce qui a été écrit depuis ; une vérification à l'affichage protège la
 * page, ce qui est la seule chose qui compte pour le visiteur.
 */
const liens = liensDuProjet(projet.id)
  .map((l) => ({ ...l, url: lienSur(l.url) }))
  .filter((l) => l.url && l.libelle);

/** Ce qu'on montre à côté du libellé : le domaine, ou le chemin. */
function ouCaMene(url: string): string {
  if (url.startsWith('/')) return url;
  if (url.startsWith('mailto:')) return url.slice(7);
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}
const externe = (url: string) => /^https?:/i.test(url);

const lesCredits = credits.map((c) => ({ ...c, url: lienSur(c.url) }));

const metas = [
  ['Mon rôle', projet.role],
  ['Réalisation', projet.realisation],
  ['Production', projet.production],
  ['Diffusion', projet.diffusion],
].filter(([, v]) => v);
---

<Base titre={projet.titre} description={projet.resume} actif="projets">
  {projet.statut !== 'publie' && <p class="brouillon mono">Brouillon — visible seulement parce que vous êtes connecté</p>}

  <article>
    <header class="heros">
      <div class="heros__fond">
        {
          hero ? (
            <Media media={hero} ratio="16 / 9" tailles="100vw" prioritaire={true} classe="heros__image" />
          ) : (
            <div class="heros__repli" aria-hidden="true" />
          )
        }
        <Grain id={`p${projet.id}`} opacite={0.26} />
      </div>
      <div class="heros__voile" aria-hidden="true"></div>
      <div class="contenu heros__haut">
        <span class="mono">Pl. 01</span>
        {projet.annee && <span class="mono">{projet.annee}</span>}
      </div>
      <div class="contenu heros__bas">
        <h1 class="heros__titre">{projet.titre}</h1>
        {projet.chapeau && <p class="heros__chapeau">{projet.chapeau}</p>}
      </div>
    </header>

    {
      metas.length > 0 && (
        <div class="contenu contenu--planche bande-meta">
          {metas.map(([k, v]) => (
            <div class="bande-meta__case">
              <p class="etiquette">{k}</p>
              <p>{v}</p>
            </div>
          ))}
        </div>
      )
    }

    {
      projet.youtube && (
        <div class="contenu contenu--planche bloc-video differe">
          <FacadeYoutube youtube={projet.youtube} titre={projet.titre} />
        </div>
      )
    }

    <!-- Bascule sur le mode planche : c'est ici, et seulement ici, qu'on lit. -->
    <div class="planche differe differe--long" data-mode="planche">
      <div class="contenu contenu--planche planche__grille">
        <aside class="marge">
          {
            faits.length > 0 && (
              <>
                <hr class="filet" />
                <p class="fiche__titre mono">Fiche technique</p>
                <dl class="fiche mono">
                  {faits.map((f) => (
                    <div class="fiche__ligne">
                      <dt>{f.etiquette}</dt>
                      <dd>{f.valeur}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )
          }
          {projet.note && <><hr class="filet" /><p class="marge__note">{projet.note}</p></>}
        </aside>

        <div class="corps">
          {
            sections.map((s, i) => (
              <section class="section">
                <p class="etiquette etiquette--accent">
                  {String(i + 1).padStart(2, '0')} — {s.titre}
                </p>
                {s.corps
                  .split(/\n{2,}/)
                  .filter(Boolean)
                  .map((para) => (
                    <p>{para}</p>
                  ))}
              </section>
            ))
          }

          {
            projet.citation && (
              <blockquote class="citation">
                <p>« {projet.citation} »</p>
                {projet.citation_qui && <cite class="mono">{projet.citation_qui}</cite>}
              </blockquote>
            )
          }
        </div>
      </div>

      {
        liens.length > 0 && (
          <div class="contenu contenu--planche liens">
            <p class="etiquette etiquette--accent">Liens</p>
            <ul class="liens__liste">
              {liens.map((l) => (
                <li>
                  <a
                    class="lien"
                    href={l.url}
                    target={externe(l.url) ? '_blank' : undefined}
                    rel={externe(l.url) ? 'noopener' : undefined}
                  >
                    <span class="lien__libelle">
                      {l.libelle}
                      {externe(l.url) && (
                        <span class="lien__fleche" aria-hidden="true">
                          ↗
                        </span>
                      )}
                    </span>
                    <span class="mono lien__ou">{ouCaMene(l.url)}</span>
                    {l.note && <span class="lien__note">{l.note}</span>}
                    {externe(l.url) && <span class="visuellement-cache">(nouvel onglet)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        galerie.length > 0 && (
          <div class="contenu galerie">
            <Carrousel entrees={galerie} titre={projet.titre} />
          </div>
        )
      }

      {
        lesCredits.length > 0 && (
          <div class="contenu contenu--planche planche__grille bloc-credits">
            <aside class="marge">
              <p class="etiquette etiquette--accent">Crédits</p>
              <hr class="filet" />
              <p class="marge__note">{r.credits_note || NOTE_CREDITS}</p>
            </aside>
            <dl class="credits mono">
              {lesCredits.map((c) => {
                const nom = c.cest_moi ? <mark>{c.noms}</mark> : c.noms;
                return (
                  <div class="credits__ligne">
                    <dt>{c.poste}</dt>
                    <dd>
                      {c.url ? (
                        <a
                          class="credits__lien"
                          href={c.url}
                          target={externe(c.url) ? '_blank' : undefined}
                          rel={externe(c.url) ? 'noopener' : undefined}
                        >
                          {nom}
                          {externe(c.url) && (
                            <span class="lien__fleche" aria-hidden="true">
                              ↗
                            </span>
                          )}
                          {externe(c.url) && <span class="visuellement-cache">(nouvel onglet)</span>}
                        </a>
                      ) : (
                        nom
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          </div>
        )
      }
    </div>

    <nav class="sorties contenu contenu--planche differe differe--court" aria-label="Suite">
      {
        suivant && suivant.id !== projet.id && (
          <a class="sortie sortie--grande" href={`/projets/${suivant.slug}`}>
            <span class="etiquette etiquette--accent">Projet suivant</span>
            <span class="sortie__titre">{suivant.titre}</span>
          </a>
        )
      }
      <a class="sortie" href="/projets">
        <span class="etiquette">Tout le reste</span>
        <span class="sortie__titre sortie__titre--petit">L'annuaire</span>
      </a>
      <a class="sortie sortie--accent" href="/contact">
        <span class="etiquette etiquette--accent">Un projet comme celui-ci ?</span>
        <span class="sortie__titre sortie__titre--petit">Parlons-en</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  /* Elle est le premier élément de la page, donc sous le bandeau fixe —
     qui fait 62 px, contre 45 px pour elle : elle était intégralement
     cachée. L'avertissement le plus important de la page ne s'est jamais
     affiché à personne. */
  .brouillon {
    background: var(--reactif);
    color: var(--abysse);
    text-align: center;
    padding: var(--e-3);
    padding-top: calc(var(--hauteur-bandeau) + var(--e-3));
    margin: 0;
  }

  .heros {
    position: relative;
    min-height: 78vh;
    min-height: 78svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: calc(var(--hauteur-bandeau) + var(--e-4)) var(--e-6);
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
  }
  .heros__fond {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .heros__fond :global(.heros__image) {
    width: 100%;
    height: 100%;
  }
  .heros__fond :global(.heros__image img) {
    height: 100%;
    object-fit: cover;
  }
  .heros__repli {
    position: absolute;
    inset: 0;
    background: linear-gradient(148deg, #c6dbeb 0%, #5f8fb8 26%, #1e4874 60%, #0a1428 100%);
  }
  .heros__voile {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Deux couches. La seconde est le dégradé d'ensemble ; la première est
       une bande sombre en haut, pour le numéro de planche et l'année.
       Ils étaient posés en blanc sur un voile à 26 % — sur une photo
       claire, un rapport de 1,8:1, c'est-à-dire illisible. */
    /* La bande est exprimée en pixels, et non en pourcentage de la
       hauteur. En pourcentage, elle rétrécissait avec le héros : sur un
       téléphone, le texte — posé à une distance FIXE du haut — retombait
       dans la partie déjà transparente, et revenait à 1,6:1 sur une photo
       claire. C'est-à-dire au niveau d'avant la correction. */
    background:
      linear-gradient(
        180deg,
        rgba(10, 20, 40, 0.85) 0,
        rgba(10, 20, 40, 0.85) calc(var(--hauteur-bandeau) + 3.5rem),
        rgba(10, 20, 40, 0) calc(var(--hauteur-bandeau) + 7rem)
      ),
      linear-gradient(200deg, rgba(10, 20, 40, 0.26) 0%, rgba(10, 20, 40, 0.16) 38%, rgba(10, 20, 40, 0.9) 100%);
  }
  .heros__haut {
    display: flex;
    justify-content: space-between;
    gap: var(--e-4);
    flex-wrap: wrap;
  }
  .heros__haut .mono {
    color: var(--papier);
  }
  .heros__bas {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
  }
  .heros__titre {
    font-size: var(--t-900);
  }
  .heros__chapeau {
    color: var(--texte-doux);
    font-size: var(--t-400);
    max-width: 42rem;
  }

  .bande-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: var(--e-4);
    padding-block: var(--e-4);
    border-bottom: 1px solid var(--filet);
  }
  .bande-meta__case + .bande-meta__case {
    border-left: 1px solid var(--filet);
    padding-left: var(--e-4);
  }
  .bande-meta__case p:last-child {
    margin-top: var(--e-2);
  }

  /* La vidéo occupait toute la largeur de l'écran : sur un grand moniteur,
     un rectangle de deux mètres de large au milieu d'une page de lecture.
     Elle est bornée et centrée, comme une planche. */
  .bloc-video {
    padding-block: var(--e-6);
  }
  .bloc-video :global(.yt) {
    max-width: 52rem;
    /* Centrée dans la planche, et non plus calée contre son bord gauche :
       la planche étant elle-même centrée, l'axe de la page est enfin le
       même du héros aux trois sorties. */
    margin-inline: auto;
  }

  /* --- Mode planche ------------------------------------------------ */
  .planche {
    background: var(--fond);
    color: var(--texte);
    padding-block: var(--e-7);
  }
  .planche__grille {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 62rem);
    gap: var(--e-6);
    align-items: start;
    /* Les deux colonnes ont une largeur bornée : sans cela, elles se
       plaquaient contre le bord gauche de l'écran dès que celui-ci
       dépassait la largeur d'une planche. Le couple marge + lecture est
       centré, et c'est lui qui donne l'axe de la page. */
    justify-content: center;
  }
  .marge {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    position: sticky;
    top: calc(var(--hauteur-bandeau) + var(--e-4));
  }
  .marge__note {
    color: var(--texte-doux);
    font-size: var(--t-200);
    font-style: italic;
  }
  .fiche {
    margin: 0;
    font-size: var(--t-100);
    letter-spacing: 0.1em;
    color: var(--texte-doux);
  }
  .fiche__titre {
    color: var(--texte);
    margin-bottom: var(--e-3);
  }
  .fiche__ligne {
    display: flex;
    justify-content: space-between;
    gap: var(--e-3);
    padding-block: var(--e-2);
  }
  .fiche__ligne dd {
    margin: 0;
    color: var(--texte);
    text-align: right;
  }

  .corps {
    display: flex;
    flex-direction: column;
    gap: var(--e-5);
    max-width: var(--mesure);
  }
  .section {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    padding-bottom: var(--e-5);
    border-bottom: 1px solid var(--filet);
  }
  .section p + p {
    margin-top: var(--e-3);
  }
  .citation {
    margin: 0;
    padding-left: var(--e-4);
    border-left: 2px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
  }
  .citation p {
    font-style: italic;
    font-size: var(--t-400);
  }
  .citation cite {
    font-style: normal;
    color: var(--texte-doux);
  }

  /* --- Les liens ---------------------------------------------------- */
  .liens {
    margin-top: var(--e-7);
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
  }
  .liens__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* « min(100%, …) » : sans lui, une colonne de 18 rem reste large de
       18 rem sur un écran de 320 px, et la grille déborde. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--e-4);
  }
  .lien {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    height: 100%;
    padding: var(--e-4);
    border: 1px solid var(--filet);
    color: var(--texte);
    text-decoration: none;
  }
  .lien:hover,
  .lien:focus-visible {
    border-color: var(--accent);
  }
  .lien__libelle {
    font-family: var(--display);
    font-weight: 300;
    font-size: var(--t-400);
    line-height: var(--interligne-titre);
    /* Une adresse collée dans le libellé ne doit pas élargir la carte. */
    overflow-wrap: anywhere;
  }
  .lien__fleche {
    margin-left: 0.35em;
    color: var(--accent);
  }
  .lien__ou {
    color: var(--texte-doux);
    font-size: var(--t-100);
    overflow-wrap: anywhere;
  }
  .lien__note {
    color: var(--texte-doux);
    font-size: var(--t-200);
  }

  /* La galerie est le seul bloc de la planche qui garde toute la largeur,
     et c'est volontaire : ses deux flèches se tiennent aux bords de la
     page, l'image respire entre elles. Le composant porte sa propre mise
     en forme ; il ne reste ici que sa place dans la page. */
  .galerie {
    margin-top: var(--e-7);
  }

  .bloc-credits {
    margin-top: var(--e-7);
  }
  .credits {
    margin: 0;
    font-size: var(--t-200);
    letter-spacing: 0.06em;
  }
  .credits__ligne {
    display: grid;
    grid-template-columns: minmax(10rem, 16rem) minmax(0, 1fr);
    gap: var(--e-4);
    padding-block: var(--e-3);
    border-top: 1px solid var(--filet);
  }
  .credits__ligne:last-child {
    border-bottom: 1px solid var(--filet);
  }
  .credits dt {
    color: var(--texte-doux);
    text-transform: uppercase;
  }
  .credits dd {
    margin: 0;
    color: var(--texte);
    text-transform: uppercase;
    /* Un nom sans espace — un pseudonyme, un studio — ne doit pas pousser
       la colonne hors de l'écran sur un téléphone. */
    overflow-wrap: anywhere;
  }
  .credits :global(mark) {
    background: none;
    color: inherit;
    border-bottom: 2px solid var(--accent);
  }
  /* Le lien d'un nom crédité. Souligné au survol seulement : une colonne
     de noms tous soulignés se lit comme une liste de boutons. */
  .credits__lien {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--filet-fort);
  }
  .credits__lien:hover,
  .credits__lien:focus-visible {
    border-bottom-color: var(--accent);
    color: var(--accent);
  }

  /* --- Les trois sorties ------------------------------------------- */
  .sorties {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--e-4);
    padding-block: var(--e-7);
  }
  .sortie {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    justify-content: center;
    padding: var(--e-5);
    border: 1px solid var(--filet);
    color: var(--texte);
    text-decoration: none;
    min-height: 9rem;
  }
  .sortie--grande {
    grid-column: span 2;
    border-color: var(--filet-fort);
  }
  .sortie--accent {
    border-color: var(--reactif);
    color: var(--reactif);
  }
  .sortie:hover,
  .sortie:focus-visible {
    border-color: var(--reactif);
  }
  .sortie__titre {
    font-family: var(--display);
    font-weight: 200;
    font-size: var(--t-600);
    line-height: 1.1;
  }
  .sortie__titre--petit {
    font-size: var(--t-500);
  }

  @media (max-width: 61.99rem) {
    .planche__grille {
      grid-template-columns: minmax(0, 1fr);
    }
    .marge {
      position: static;
    }
    .credits__ligne {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-1);
    }
    .sortie--grande {
      grid-column: auto;
    }
    .bande-meta__case + .bande-meta__case {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
