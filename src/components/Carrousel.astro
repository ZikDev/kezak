---
import Media from './Media.astro';
import FacadeYoutube from './FacadeYoutube.astro';

/**
 * La galerie d'un projet, vue par vue.
 *
 * Deuxième écriture. La première posait chaque vue dans un cadre : fond
 * gris, filet d'un pixel, flèches en boîte collées contre l'image. Trois
 * meubles autour d'une photo — et une photo qu'on regarde à travers un
 * meuble n'est plus regardée. Ici :
 *
 *   — aucun fond, aucune bordure. Le média est posé sur la planche, rien
 *     ne le borde, rien ne le souligne ;
 *   — les flèches se tiennent aux deux bords de la page, dans une voie qui
 *     leur est réservée : elles ne passent jamais par-dessus l'image ;
 *   — « contain » et jamais « cover » : l'image entière, quelles que
 *     soient ses proportions. C'est la seule façon de montrer une affiche
 *     verticale ;
 *   — les couleurs d'origine. La bichromie est l'écriture du site, pas
 *     celle des travaux qu'il montre.
 *
 * Toutes les vues partagent une hauteur unique : sans elle, la page
 * sauterait à chaque changement de vue, et les flèches avec elle.
 *
 * Trois natures d'entrée : une image, une vidéo hébergée ici, une vidéo
 * YouTube — cette dernière derrière la même façade que le reste du site,
 * donc sans rien charger de tiers avant un clic.
 *
 * Sans JavaScript, c'est un simple défilement horizontal avec accroche :
 * les flèches disparaissent, tout le reste fonctionne.
 */
interface Props {
  entrees: Record<string, any>[];
  titre: string;
}
const { entrees, titre } = Astro.props;
const total = entrees.length;
---

{
  total > 0 && (
    <section
      class:list={['carrousel', total === 1 && 'carrousel--seule']}
      data-carrousel
      aria-roledescription={total > 1 ? 'carrousel' : undefined}
      aria-label={`Galerie — ${titre}`}
    >
      {/*
        « tabindex » sur la piste : un conteneur de défilement n'est pas
        focalisable au clavier dans Safari ni dans les Chrome anciens.
        Sans lui, et sans script, une galerie de photos était visible à
        la première vue et les suivantes inatteignables autrement qu'à
        la souris.
      */}
      <ul class="carrousel__piste" data-piste tabindex="0" role="group" aria-label="Vues de la galerie">
        {entrees.map((e, i) => (
          <li
            class="carrousel__vue"
            id={`vue-${e.id}`}
            role="group"
            aria-roledescription="vue"
            aria-label={`${i + 1} sur ${total}`}
          >
            <figure class="vue__contenu">
              {e.youtube ? (
                <div class="vue__yt">
                  <FacadeYoutube youtube={e.youtube} titre={e.legende || titre} />
                </div>
              ) : e.type === 'video' ? (
                <video
                  class="vue__video"
                  src={`/media/${e.fichier}`}
                  controls
                  playsinline
                  preload="metadata"
                  aria-label={e.legende || `Vidéo ${i + 1}`}
                />
              ) : (
                <Media
                  media={e}
                  ratio="auto"
                  ajuste="contain"
                  classe="vue__image"
                  tailles="(max-width: 48rem) 100vw, 80vw"
                  prioritaire={i === 0}
                />
              )}
              {e.legende && <figcaption class="mono vue__legende">{e.legende}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>

      {total > 1 && (
        <div class="carrousel__barre">
          <button
            class="carrousel__fleche carrousel__fleche--prec"
            type="button"
            data-prec
            aria-label="Vue précédente"
          >
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M20 5 9 16l11 11" />
            </svg>
          </button>

          <p class="carrousel__compteur mono" aria-live="polite">
            <span data-rang>1</span> / {total}
          </p>

          <button
            class="carrousel__fleche carrousel__fleche--suiv"
            type="button"
            data-suiv
            aria-label="Vue suivante"
          >
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M12 5l11 11-11 11" />
            </svg>
          </button>
        </div>
      )}
    </section>
  )
}

<style>
  .carrousel {
    /* Une seule source pour la hauteur d'une vue. Elle était écrite deux
       fois — sur le média et dans le calcul qui centre les flèches — et
       changer l'une sans l'autre aurait décentré les flèches en silence.
       Le repli en « vh » n'est pas décoratif : sans lui, un navigateur
       qui ignore « svh » invalide tout le clamp, et la hauteur du média
       ET la position des flèches tombent d'un coup. */
    --h-vue: clamp(16rem, 62vh, 38rem);
    /* La voie réservée aux flèches, de chaque côté. C'est elle qui garantit
       qu'une image panoramique ne passera jamais dessous. */
    --voie-fleche: 4.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    /* Les flèches se tiennent aux bords de la page — mais une page peut
       faire deux mètres de large. Passé ce plafond, l'écart entre les deux
       flèches ne dit plus rien de la galerie : il faudrait traverser
       l'écran pour passer à l'image suivante. En deçà — tout écran de
       bureau jusqu'à 1760 px environ — rien ne change. */
    max-width: 110rem;
    margin-inline: auto;
  }
  /* Une seule vue : pas de flèches, donc pas de voie à leur réserver.
     L'image prend toute la largeur disponible. */
  .carrousel--seule {
    --voie-fleche: 0px;
  }
  @supports (height: 1svh) {
    .carrousel {
      --h-vue: clamp(16rem, 62svh, 38rem);
    }
  }

  /* L'accroche au défilement fait tout le travail : une vue occupe la
     largeur, et le doigt comme la molette s'arrêtent pile dessus. Les
     flèches ne font que piloter ce même défilement. */
  .carrousel__piste {
    list-style: none;
    margin: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    /* La barre de défilement est masquée : le compteur et les flèches
       disent déjà où l'on en est, et elle couperait le bas des images. */
    scrollbar-width: none;
    /* Les deux voies des flèches sont prises en marge EXTÉRIEURE, et non
       en marge intérieure. En marge intérieure, la piste se coupait à son
       cadre et non à son contenu : la vue suivante apparaissait dans la
       voie, sous la flèche — une bande d'image qui n'a rien à faire là.
       Avec une marge extérieure, la piste s'arrête où elle est coupée.
       « padding-block » de 4 px : l'anneau de focus d'une vidéo dépasse de
       3 px, et la piste le rognait par le haut et par le bas. */
    margin-inline: var(--voie-fleche);
    /* La marge intérieure que le navigateur pose d'office sur une liste :
       40 px, à gauche. Elle décalait toutes les vues, et la voisine
       reparaissait par la droite — la bande d'image qu'on croyait avoir
       supprimée. Une liste sans puces n'a besoin d'aucun retrait. */
    padding-inline: 0;
    padding-block: 4px;
    scroll-padding-block: 4px;
  }
  .carrousel__piste::-webkit-scrollbar {
    display: none;
  }

  .carrousel__vue {
    scroll-snap-align: center;
    scroll-snap-stop: always;
    min-width: 0;
  }

  .vue__contenu {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
  }

  /* Hauteur bornée, et proportionnelle à l'écran plutôt que fixe : une
     image ne doit jamais demander de faire défiler pour être vue en
     entier, ni sur un téléphone ni sur un grand moniteur.
     Aucun fond, aucune bordure : c'est le média qu'on regarde, et rien
     d'autre. Le vide laissé par une image verticale n'a pas à être
     dessiné — il suffit qu'il soit vide. */
  .vue__contenu :global(.vue__image),
  .vue__video,
  .vue__yt {
    width: 100%;
    height: var(--h-vue);
  }
  .vue__contenu :global(.vue__image) {
    aspect-ratio: auto;
  }
  .vue__video {
    object-fit: contain;
    background: none;
  }
  /* Faute de marge horizontale, l'anneau de focus se dessine à
     l'intérieur : à l'extérieur, la piste le couperait sur la première et
     la dernière vue, là précisément où l'on arrive au clavier. */
  .vue__video:focus-visible {
    outline-offset: -3px;
  }
  /* La façade YouTube garde ses proportions 16/9 : sa largeur doit tenir
     compte de la hauteur disponible, sinon elle déborde du cadre dès que
     la fenêtre est basse — un portable 13 pouces suffit — et se fait
     rogner par le haut. Elle est centrée, et dépouillée du filet et du
     fond qu'elle porte ailleurs sur le site. */
  .vue__yt {
    display: grid;
    place-items: center;
  }
  .vue__yt :global(.yt) {
    width: min(100%, 60rem, calc(var(--h-vue) * 16 / 9));
    border: 0;
    background: none;
  }

  .vue__legende {
    color: var(--texte-doux);
    text-align: center;
    max-width: var(--mesure);
    margin-inline: auto;
  }

  /* --- Les flèches et le compteur ----------------------------------- */
  .carrousel__barre {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-4);
  }

  .carrousel__fleche {
    /* Sans script, les flèches ne pilotent rien : elles ne s'affichent
       pas, et le défilement horizontal reste parfaitement utilisable. */
    display: none;
    width: 3rem;
    height: 3rem;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--texte-doux);
    cursor: pointer;
    transition:
      color var(--duree) var(--courbe),
      opacity var(--duree) var(--courbe);
  }
  :global(html.js-ok) .carrousel__fleche {
    display: grid;
  }
  .carrousel__fleche:hover,
  .carrousel__fleche:focus-visible {
    color: var(--accent);
  }
  /* Une flèche en fin de course reste lisible : trop effacée, on ne
     distingue plus « fin de la galerie » de « la commande a disparu ». */
  .carrousel__fleche[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
    color: var(--texte-doux);
  }

  .carrousel__compteur {
    color: var(--texte-doux);
    letter-spacing: var(--ls-etiquette);
    margin: 0;
  }

  /* À partir d'une tablette, les flèches quittent le fil pour se poser aux
     deux bords de la page, à mi-hauteur du média — dans les voies que la
     piste leur a réservées. Le compteur reste seul au centre, sous
     l'image. */
  @media (min-width: 48rem) {
    .carrousel__fleche {
      position: absolute;
      /* Les 4 px sont la marge haute de la piste : sans eux, les flèches
         se posent 4 px au-dessus du milieu du média. On ne le verrait
         pas — raison de plus pour que ce soit juste. */
      top: calc(4px + var(--h-vue) / 2);
      transform: translateY(-50%);
      width: var(--voie-fleche);
      height: var(--voie-fleche);
    }
    .carrousel__fleche--prec {
      left: 0;
    }
    .carrousel__fleche--suiv {
      right: 0;
    }
  }

  /* Sur un téléphone, la voie des flèches rognerait l'image d'un tiers :
     la piste reprend toute la largeur, et les flèches descendent de part
     et d'autre du compteur. */
  @media (max-width: 47.99rem) {
    .carrousel {
      --voie-fleche: 0px;
      /* La hauteur tient compte de la largeur, et pas seulement de la
         hauteur de l'écran. Sur un téléphone tenu droit, une image
         horizontale ne fait qu'un cinquième de la scène : à 62 % de la
         hauteur d'écran, elle flottait au milieu de trois cents pixels de
         vide, qu'il fallait faire défiler pour rien. */
      --h-vue: min(58vh, 80vw);
    }
    @supports (height: 1svh) {
      .carrousel {
        --h-vue: min(58svh, 80vw);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carrousel__piste {
      scroll-behavior: auto;
    }
  }
</style>
