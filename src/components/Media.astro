---
import { srcset } from '../lib/media';

interface Props {
  media?: Record<string, any> | null;
  /** Rapport largeur/hauteur imposé, pour qu'il n'y ait aucun décalage.
      « auto » laisse l'image prendre ses proportions réelles. */
  ratio?: string;
  /**
   * « cover » rogne pour remplir le cadre, « contain » montre l'image
   * entière quitte à laisser du vide. La galerie utilise « contain » :
   * une photo de projet rognée par le milieu ne montre pas le projet.
   */
  ajuste?: 'cover' | 'contain';
  tailles?: string;
  prioritaire?: boolean;
  classe?: string;
  /** Dégradé de repli quand aucun média n'est encore chargé. */
  repli?: string;
}

const {
  media = null,
  ratio = '16 / 9',
  ajuste = 'cover',
  tailles = '100vw',
  prioritaire = false,
  classe = '',
  repli = 'linear-gradient(148deg, #c6dbeb 0%, #5f8fb8 26%, #1e4874 60%, #0a1428 100%)',
} = Astro.props;

let variantes: Record<string, string> = {};
try {
  variantes = media?.variantes ? JSON.parse(media.variantes) : {};
} catch {
  variantes = {};
}
const aDesVariantes = Object.keys(variantes).some((c) => c.startsWith('webp'));
const src = variantes.webp1600 || variantes.webp800 || variantes.webp400;
const proportions = ratio === 'auto' ? 'auto' : ratio;
---

{
  media && aDesVariantes ? (
    <picture class={classe} style={`--ratio:${proportions};--ajuste:${ajuste}`}>
      <source type="image/avif" srcset={srcset(variantes, 'avif')} sizes={tailles} />
      <source type="image/webp" srcset={srcset(variantes, 'webp')} sizes={tailles} />
      <img
        src={`/media/${src}`}
        alt={media.alt || ''}
        width={media.largeur || undefined}
        height={media.hauteur || undefined}
        loading={prioritaire ? 'eager' : 'lazy'}
        decoding={prioritaire ? 'sync' : 'async'}
        fetchpriority={prioritaire ? 'high' : 'auto'}
      />
    </picture>
  ) : (
    <div class={`repli ${classe}`} style={`--ratio:${proportions}; --repli:${repli}`} aria-hidden="true" />
  )
}

<style>
  picture {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
  }
  picture img {
    width: 100%;
    height: 100%;
    object-fit: var(--ajuste, cover);
  }
  .repli {
    width: 100%;
    aspect-ratio: var(--ratio);
    background: var(--repli);
  }
</style>
