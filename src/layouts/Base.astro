---
import '../styles/tokens.css';
import '../styles/base.css';
// Chargée ici seulement : l'administration ne doit pas hériter des
// transitions de page du site public.
import '../styles/transitions.css';
import Bandeau from '../components/Bandeau.astro';
import RideauChargement from '../components/RideauChargement.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { tousReglages } from '../lib/db';

interface Props {
  titre: string;
  description?: string;
  /** L'accueil masque le bandeau sur le premier écran. */
  bandeauDifferre?: boolean;
  actif?: 'projets' | 'studio' | 'contact' | null;
  image?: string;
}

const { titre, description = '', bandeauDifferre = false, actif = null, image } = Astro.props;
const r = tousReglages();
const site = r.site_nom || 'Kezak';
const titreComplet = titre === site ? site : `${titre} — ${site}`;
const desc = description || r.seo_description || '';

/**
 * L'adresse canonique de la page.
 *
 * Elle était prise sur `Astro.url.href`, et c'est le même piège que la
 * protection anti-CSRF : derrière un proxy qui termine le HTTPS,
 * l'application reçoit la requête en clair et `Astro.url` commence par
 * « http:// ». Les balises canoniques et Open Graph annonçaient donc une
 * adresse non sécurisée — de quoi brouiller le référencement et les
 * aperçus de partage. On repart du domaine configuré, et on n'emprunte à
 * la requête que le chemin et les paramètres.
 */
const domaine = process.env.SITE_URL || Astro.site?.href || Astro.url.origin;
const url = new URL(Astro.url.pathname + Astro.url.search, domaine).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titreComplet} />
    {desc && <meta property="og:description" content={desc} />}
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="fr_CH" />
    {image && <meta property="og:image" content={new URL(image, Astro.url).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a1428" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/Lineal-Thin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Spectral-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {/*
      Dit au navigateur de ne rien peindre avant que #contenu existe.
      Pendant une transition entre deux pages, c'est ce qui la fait durer
      exactement le temps du chargement : l'image de la page quittée reste
      à l'écran jusqu'à ce que la suivante soit prête, au lieu d'un blanc
      puis d'un saut. Les navigateurs qui ne connaissent pas cette valeur
      l'ignorent : rien ne change pour eux.
    */}
    <link rel="expect" href="#contenu" blocking="render" />
    <script src="/js/site.js" defer is:inline></script>
  </head>
  <body>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    {/*
      Le rideau vient avant tout le reste : il est déjà là quand la page
      se peint pour la première fois, et il se lève quand elle est prête.
      Placé plus bas, on aurait vu le contenu une fraction de seconde
      avant qu'il ne le recouvre — le contraire de ce qu'on cherche.
    */}
    <RideauChargement />
    <div class="fil" aria-hidden="true"></div>
    <Bandeau differe={bandeauDifferre} actif={actif} />
    <main id="contenu">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>
