# Copier ce fichier en .env et remplir. Ne jamais committer le .env.

# URL publique du site, sans barre oblique finale
SITE_URL=https://kezak.ch

# Port d'écoute de l'application Node
PORT=4321
HOST=0.0.0.0

# Emplacements persistants. En production, les placer HORS du dossier
# de déploiement pour qu'ils survivent aux mises à jour.
# Exemple Infomaniak : /home/clients/xxxx/persistant/kezak
DATA_DIR=./data
UPLOADS_DIR=./uploads

# Aucun secret de session n'est nécessaire : le jeton de connexion est tiré
# au hasard (32 octets) et seule son empreinte SHA-256 est stockée en base.
# Il n'y a donc rien à signer, et rien à faire fuiter.

# SMTP Infomaniak pour le formulaire de contact
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=contact@kezak.ch
SMTP_PASS=
MAIL_FROM=Site Kezak <contact@kezak.ch>
MAIL_TO=contact@kezak.ch

# Mettre à 1 en développement local (désactive l'exigence de cookie Secure)
DEV_INSECURE_COOKIES=0
